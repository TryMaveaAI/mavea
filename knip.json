{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/**/*.{mts,mjs}"],
  "ignore": ["src/canvas/blocks/*/types.ts"],
  "ignoreIssues": {
    "src/live/ripple/cache.ts": ["exports"],
    "src/live/ripple/ingest/generate.ts": ["exports"],
    "src/live/semantic/client.ts": ["exports"],
    "src/live/srs/store.ts": ["exports"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["pdfinfo", "pdftotext", "xdg-open"],
  "entry": [
    "tests/**/*.test.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{mts,mjs}",
    "bin/*.mjs"
  ]
}
