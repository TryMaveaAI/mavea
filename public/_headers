# Security response headers for the built app.
#
# The Content-Security-Policy is written once, in index.html's <meta> tag, so it applies on any
# host. It is repeated here as a real header because a header is enforced before the first byte of
# the page is parsed, and because it can carry `frame-ancestors`, which a meta tag cannot. The line
# below is that meta policy plus `frame-ancestors 'none'`, byte for byte — tests/csp-parity.test.ts
# fails if the two drift, so edit index.html first and copy the policy here. The other headers cannot
# be expressed in a meta tag at all, so they have to come from whatever actually serves dist/. This
# file is the format Cloudflare Pages and Netlify read directly out of the publish directory; Vite
# copies it verbatim from public/.
#
# A path matched by several rules gets every rule's headers, and Cloudflare Pages joins a header
# set twice with a comma: `no-cache` from /* would ride along with the immutable lifetime below and
# win, and the PDF rule's `frame-ancestors 'self'` would sit beside /*'s `'none'` as a second policy
# that still refuses the frame. So each narrower rule first detaches (`! Name`) what it replaces;
# Pages applies a rule's detaches before its own values. Netlify's parser skips those lines.
#
# If you deploy somewhere else, these are the headers to carry across (nginx `add_header`, an S3 +
# CloudFront response-headers policy, a Vercel `headers` block, and so on). Do not drop
# Permissions-Policy: Mavéa asks for the microphone, and that line is what keeps an embedded or
# third-party context from asking on its behalf.

/*
  # No one frames Mavéa. Clickjacking a voice app means clickjacking a mic prompt.
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'sha256-Xdp7H/Cx6wyDBvyCtY9Ez7J+ZzYww0aA6H6TGHNRcCg=' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://upload.wikimedia.org https://tiles.openfreemap.org; connect-src 'self' https://en.wikipedia.org https://api.github.com https://upload.wikimedia.org https://tiles.openfreemap.org; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; trusted-types mavea mavea-inert default; require-trusted-types-for 'script'; frame-ancestors 'none'
  # The mic is ours and same-origin only. The camera and location are things we never use, so they
  # are denied outright rather than left to the default.
  Permissions-Policy: microphone=(self), display-capture=(self), camera=(), geolocation=()
  # BYOK keys travel over this connection. It is HTTPS or it is nothing.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # HTML and unhashed root assets revalidate. Fingerprinted /assets/* gets the one-year override
  # below; this also covers the origin path `/`, not only an explicit `/index.html` request.
  Cache-Control: no-cache

# Hashed build assets are immutable by construction; the entry HTML never is.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# These filenames are stable rather than content-hashed, so keep the repeat-load win bounded and
# revalidate in the background instead of treating them as immutable across future releases.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/semantic/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/demo-assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The app shell is never frameable. This narrow exception lets only bundled PDF assets render in
# Pdfreader's same-origin iframe; other demo assets inherit DENY from /*.
/demo-assets/pdf/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Cross-Origin-Resource-Policy: same-origin
  Content-Disposition: inline

/index.html
  ! Cache-Control
  Cache-Control: no-cache
