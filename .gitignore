*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───── caches ─────
.vite/
.cache/
.eslintcache
.ruff_cache/

# ───── editors & OS ─────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ───── agent-local (never published) ─────
CLAUDE.md
AGENTS.md
.claude/
.session-coordination.md

# Local review artifacts (Playwright MCP sessions, usability screenshots)
.playwright-mcp/
.mavea-review/

# Actions gateway token store when run on the host (`pnpm actions`)
gateway/.gateway-data/

# Generated semantic-fit model assets (built by scripts/build-semantic-index.py; ~7MB, lazy-fetched at runtime)
public/semantic/

# Offline eval artifacts: pairwise labels + fitted-weight reports (regenerate with pnpm pairs:selection)
eval-out/

# Internal security review — kept out of the repo (agent/working artifact, not a public doc).
security_best_practices_report.md
