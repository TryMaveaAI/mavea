diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000..642ceb5
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,10 @@
+'use strict';
+
+// Bound nesting before recursive AST walkers can exhaust the call stack.
+const MAX_DEPTH = 128;
+
+exports.checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new RangeError(`Brace nesting exceeds maximum depth (${MAX_DEPTH})`);
+  }
+};
